{
  "_doc": "Biblioteca de arquétipos. 'beats' define a ordem narrativa; 'w' é o peso de duração. 'text' diz de onde vem o texto da cena: hook | name | fact | fact_card | cta | none. 'requires' bloqueia o arquétipo quando o Product Brief não tem os fatos necessários (nunca inventar).",
  "archetypes": {
    "PRODUCT_HERO": {
      "label": "Product Hero",
      "pace": "medium",
      "music": [
        "PREMIUM",
        "MODERN",
        "MINIMAL"
      ],
      "style": "clean",
      "requires": {
        "min_images": 1
      },
      "beats": [
        {
          "role": "HOOK",
          "shot": "hero",
          "move": [
            "push_in"
          ],
          "w": 2.6,
          "text": "hook",
          "anim": "scale",
          "sfx": "impact"
        },
        {
          "role": "PRODUCT_REVEAL",
          "shot": "hero_wide",
          "move": [
            "pull_out",
            "pan_h"
          ],
          "w": 3.0,
          "text": "name",
          "anim": "mask",
          "transition": "dissolve",
          "tw": 0.4
        },
        {
          "role": "AMBIENT",
          "shot": "broll",
          "move": [
            "static"
          ],
          "w": 2.6,
          "text": "fact:use",
          "anim": "words",
          "optional": "broll",
          "transition": "dissolve",
          "tw": 0.4
        },
        {
          "role": "DETAIL",
          "shot": "detail",
          "move": [
            "push_in",
            "diagonal"
          ],
          "w": 3.4,
          "text": "fact",
          "anim": "slide",
          "sfx": "click"
        },
        {
          "role": "BENEFIT",
          "shot": "detail2",
          "move": [
            "pan_h",
            "pan_v"
          ],
          "w": 3.4,
          "text": "fact_card",
          "anim": "slide",
          "sfx": "soft_impact"
        },
        {
          "role": "DESIRE",
          "shot": "hero",
          "move": [
            "pull_out"
          ],
          "w": 2.4,
          "text": "none",
          "transition": "dissolve",
          "tw": 0.5
        },
        {
          "role": "CTA",
          "shot": "hero_wide",
          "move": [
            "push_in"
          ],
          "w": 2.7,
          "text": "cta",
          "anim": "scale",
          "sfx": "pop",
          "transition": "match_cut"
        }
      ]
    },
